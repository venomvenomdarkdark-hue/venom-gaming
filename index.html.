const COL=['#b9b8b0','#879aa5','#c9bba6','#78858d','#d1d0c8'];
const shade=c=>{const n=parseInt(c.slice(1),16);return'#'+[16,8,0].map(s=>Math.round(((n>>s)&255)*.72).toString(16).padStart(2,'0')).join('')};
