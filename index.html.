}
for(let z=8;z<160;z+=10){trees.push({x:-8.3,z});trees.push({x:8.3,z:z+4})}
const SPAWN=[{x:80,z:125}];
const MON=SPAWN.map(p=>({...p,on:false,fall:0,st:'c',rot:0,rotT:0,stuck:0,ph:0,alert:false}));
const ZSPAWN=[{x:-60,z:25,at:3},{x:55,z:70,at:8},{x:-30,z:120,at:14}];
const ZOM=ZSPAWN.map(p=>({...p,on:false,rise:0,rot:0,rotT:0,stuck:0,ph:0,t:0,a:0,hx:0,hz:0,st:'w'}));
