].map(m=>({...m,pts:m.pts.map(([x,z])=>({x,z,got:false}))}));

const toastEl=$('msg');let tt;
function toast(s){toastEl.textContent=s;toastEl.style.display='block';clearTimeout(tt);tt=setTimeout(()=>toastEl.style.display='none',1800)}
function hud(){
