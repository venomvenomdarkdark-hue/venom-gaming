<script>
(()=>{
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
let W,H,D,skyG=null;
function resize(){W=innerWidth;H=innerHeight;D=Math.min(devicePixelRatio||1,1.5);cv.width=W*D;cv.height=H*D;ctx.setTransform(D,0,0,D,0,0);skyG=null}
addEventListener('resize',resize);resize();
const $=id=>document.getElementById(id);
const S={px:0,pz:0,yaw:0,jy:0,vy:0,air:false,run:false,moving:false,step:0,mi:0};
